FROM python:3.12.13-slim-trixie

RUN pip install --no-cache-dir uv==0.11.14

WORKDIR /app

RUN groupadd --system app && useradd --system --create-home --gid app app

COPY pyproject.toml uv.lock ./
# Limita la concorrenza di uv per contenere il picco di RAM durante il build:
# su VPS con poca memoria il sync parallelo puo' causare un OOM-kill del build.
ENV UV_CONCURRENT_DOWNLOADS=2
ENV UV_CONCURRENT_INSTALLS=2
RUN uv sync --frozen --no-dev

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY start.sh ./

RUN chmod +x start.sh && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["sh", "start.sh"]
