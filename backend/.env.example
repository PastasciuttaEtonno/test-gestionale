APP_ENV=development
APP_NAME=Gestionale Core Service
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false
REQUEST_ID_HEADER_NAME=X-Request-ID
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://app:app@db_service:5432/gestionale
JWT_SECRET_KEY=change-this-jwt-secret-key-minimum-32-chars
FIELD_ENCRYPTION_KEY=5hS0d52CvtQdjq6V2N4xZfJ6S0bFFH4hD4Xf7wYmQx0=
JWT_ALGORITHM=HS256
JWT_ISSUER=Gestionale-core-service
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_IDENTIFIER_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=30
CELERY_BROKER_URL=redis://redis_service:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis_service:6379/1
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_TRACK_STARTED=true
REDIS_URL=redis://redis_service:6379/2
REDIS_PUBSUB_URL=redis://redis_service:6379/3
DASHBOARD_KPI_CACHE_TTL_SECONDS=300
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_PROXY_IPS=[]
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTH_ENFORCE_ORIGIN_CHECK=false
REFRESH_COOKIE_NAME=Gestionale_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
